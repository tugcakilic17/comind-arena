# Google Cloud > Keşif Dünyası > Clients > Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google istemcisinde tam olarak bu callback adresini tanımlayın.
APP_URL=http://localhost:5174/
KESIF_URL=http://localhost:5173/
# Üretimde aynı alan adı altında Keşif Dünyası derleme klasörü:
KESIF_DIST=

# npm run dev:full boş bırakılırsa yerel PostgreSQL'i otomatik başlatır.
# Üretimde firmanın PostgreSQL bağlantısı yazılır; tarayıcıya gönderilmez.
DATABASE_URL=
PORT=3001
HOST=127.0.0.1
SERVE_STATIC=false
AUTO_MIGRATE=true

# Üretimde NODE_ENV=production ve AUTO_MIGRATE=false kullanılır.
# Proxy arkasında yalnızca güvenilen proxy IP/CIDR adresini belirtin.
TRUST_PROXY=false
# Derleme yolu APP_URL içindeki yol ile aynı olmalı (örn. /comind-arena/ veya /).
APP_BASE_PATH=/
