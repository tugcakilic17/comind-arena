{
  "name": "comind-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoMind Arena · 6gen — sevimli bir görsel eşleştirme oyunu",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:all": "node scripts/dev-full.mjs --with-kesif",
    "start": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "build": "vite build",
    "release": "node scripts/prepare-release.mjs",
    "test:production": "node --test tests/production-check.mjs",
    "test:browser": "node scripts/run-browser-checks.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --test tests/*.test.js",
    "test:audio": "node tests/audio-browser-check.mjs",
    "test:responsive": "node tests/responsive-check.mjs",
    "test:setup": "node tests/setup-browser-check.mjs",
    "test:setup-motion": "node tests/setup-motion-check.mjs",
    "test:mode-cues": "node tests/mode-cues-check.mjs",
    "test:parrots": "node tests/parrot-poses-check.mjs",
    "test:themes": "node tests/themes-browser-check.mjs",
    "test:profile": "node tests/profile-browser-check.mjs",
    "test:settings-fit": "node tests/settings-fit-check.mjs",
    "test:symbols": "node tests/symbols-check.mjs",
    "test:koak-symbols": "node tests/koak-symbols-check.mjs",
    "test:online": "node tests/online-browser-check.mjs",
    "demo:friends": "node scripts/friends-demo.mjs",
    "test:friends-fit": "node tests/friends-fit-check.mjs",
    "test:friends-panel": "node tests/friends-panel-check.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "qrcode": "^1.5.4"
  }
}
