# Bu dosyayı yayın klasörünün köküne .env adıyla kopyalayın.
NODE_ENV=production
APP_URL=https://oyun.example.com/comind-arena/
KESIF_URL=https://oyun.example.com/kesif-dunyasi/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kalıcı PostgreSQL bağlantısı. SSL gerekiyorsa sağlayıcının bağlantı/CA ayarını kullanın.
DATABASE_URL=
HOST=127.0.0.1
PORT=3001
SERVE_STATIC=true
AUTO_MIGRATE=false
TRUST_PROXY=127.0.0.1,::1
# Docker Compose + Caddy kullanılırsa gerçek alan adını yazın:
SITE_DOMAIN=oyun.example.com
